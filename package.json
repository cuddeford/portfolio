{
    "name": "portfolio-react",
    "version": "0.0.1",
    "scripts": {
        "client": "cd client && npm run start",
        "server": "cd server && npm run start",
        "database": "mongod",
        "dev-with-db": "concurrently --kill-others-on-fail \"npm run database\" \"npm run server\" \"npm run client\"",
        "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\""
    },
    "devDependencies": {
        "concurrently": "^3.6.0"
    }
}
